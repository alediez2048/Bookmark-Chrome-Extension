# Server Configuration
PORT=3000

# Required. The server will not start without these.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_SECRET=

# Optional. Comma-separated web origins allowed to call the API.
# The Chrome extension (chrome-extension://...) is always allowed.
CORS_ORIGINS=

# Optional. Token lifetime, in jsonwebtoken format (default 30d).
TOKEN_TTL=30d
